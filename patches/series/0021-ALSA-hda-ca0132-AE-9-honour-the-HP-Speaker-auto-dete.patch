From f31e357a7e926370546fb99f6a2ba4f815bfa316 Mon Sep 17 00:00:00 2001
From: DarkNikGr <mitakidisnikos@gmail.com>
Date: Thu, 5 Nov 2026 02:17:39 +0200
Subject: [PATCH 21/24] ALSA: hda/ca0132: AE-9: honour the HP/Speaker
 auto-detect switch

The ACM jack sample used to move the output unconditionally, so the
'HP/Speaker Auto Detect' control in the mixer did nothing and a manual
'AE-9 Output' choice was overridden on the next jack change.

Record the ACM jack state on every sample, but only switch the output
while auto-detect is enabled; while it is off the manual selection is
left alone.  When auto-detect is on, use the ACM sample instead of the
codec pin sense, because the AE-9 pins are pinned to NO_PRESENCE.

The ACM reports only the 3.5 mm jack (reg2 bit5); the 6.35 mm jack does
not change any ACM register, so it cannot drive the auto-switch.

Signed-off-by: DarkNikGr <mitakidisnikos@gmail.com>
---
 sound/hda/codecs/ca0132.c | 33 +++++++++++++++++++++++++++------
 1 file changed, 27 insertions(+), 6 deletions(-)

diff --git a/sound/hda/codecs/ca0132.c b/sound/hda/codecs/ca0132.c
index 42ea3fd..9c4df9c 100644
--- a/sound/hda/codecs/ca0132.c
+++ b/sound/hda/codecs/ca0132.c
@@ -5096,13 +5096,25 @@ static int __ca0132_alt_select_out(struct hda_codec *codec)
 	 * hp/speaker auto detect is enabled.
 	 */
 	if (auto_jack) {
-		jack_present = snd_hda_jack_detect(codec, spec->unsol_tag_hp) ||
-			   snd_hda_jack_detect(codec, spec->unsol_tag_front_hp);
+		if (ca0132_quirk(spec) == QUIRK_AE9) {
+			/* AE-9: the physical jacks are on the ACM and the codec
+			 * pins are pinned to NO_PRESENCE, so use the ACM sample.
+			 * Until the first sample, keep the current selection.
+			 */
+			if (spec->ae9_hp_jack_valid)
+				spec->cur_out_type = spec->ae9_hp_jack_present ?
+						     HEADPHONE_OUT : SPEAKER_OUT;
+			else
+				spec->cur_out_type = spec->out_enum_val;
+		} else {
+			jack_present = snd_hda_jack_detect(codec, spec->unsol_tag_hp) ||
+				   snd_hda_jack_detect(codec, spec->unsol_tag_front_hp);
 
-		if (jack_present)
-			spec->cur_out_type = HEADPHONE_OUT;
-		else
-			spec->cur_out_type = SPEAKER_OUT;
+			if (jack_present)
+				spec->cur_out_type = HEADPHONE_OUT;
+			else
+				spec->cur_out_type = SPEAKER_OUT;
+		}
 	} else
 		spec->cur_out_type = spec->out_enum_val;
 	if (ca0132_quirk(spec) == QUIRK_AE9)
@@ -10512,6 +10524,7 @@ static void ae9_acm_update_headphone_jack(struct hda_codec *codec, int reg2)
 	struct snd_kcontrol *kctl;
 	bool present = !(reg2 & 0x20);
 	bool notify = false;
+	bool auto_jack;
 	int output = present ? HEADPHONE_OUT : SPEAKER_OUT;
 	int err;
 
@@ -10526,12 +10539,20 @@ static void ae9_acm_update_headphone_jack(struct hda_codec *codec, int reg2)
 	if (!kctl)
 		return;
 
+	auto_jack = spec->vnode_lswitch[VNID_HP_ASEL - VNODE_START_NID];
+
 	CLASS(snd_hda_power_pm, pm)(codec);
 	mutex_lock(&spec->ae9_output_mutex);
 	spec->ae9_hp_jack_valid = true;
 	spec->ae9_hp_jack_present = present;
 	codec_info(codec, "AE-9 ACM: headphone jack %s (reg2=%02x)\n",
 		   present ? "inserted" : "removed", reg2);
+	/* Record the sample even with auto-detect off so that enabling it
+	 * follows the current jack; never move the output behind the user's
+	 * back while manual selection is active.
+	 */
+	if (!auto_jack)
+		goto out;
 	if (spec->out_enum_val == output && spec->cur_out_type == output)
 		goto out;
 
