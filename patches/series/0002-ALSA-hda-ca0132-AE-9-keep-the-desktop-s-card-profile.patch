From 75961d2a3eff84073f761a3d24c12b195f762a37 Mon Sep 17 00:00:00 2001
From: DarkNikGr <mitakidisnikos@gmail.com>
Date: Thu, 5 Nov 2026 02:17:07 +0200
Subject: [PATCH 02/24] ALSA: hda/ca0132: AE-9: keep the desktop's card
 profiles off the AE-9 routing

- ca0132: name the AE-9's output selector 'AE-9 Output'. The ALSA card
    profiles map an element called 'Output Select' onto sink ports and
  rewrite
  it on every route restore, which flipped the ACM relay to speakers a few
  seconds after login.
- ae9-defaults: wait for WirePlumber's sink node before writing the
routing,
  then verify after 10 s and re-apply if a late route restore moved it.
  Works with both control names.
- README: document the control name and the defaults service.

Signed-off-by: DarkNikGr <mitakidisnikos@gmail.com>
---
 sound/hda/codecs/ca0132.c | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/sound/hda/codecs/ca0132.c b/sound/hda/codecs/ca0132.c
index b4781f3..cfdcb91 100644
--- a/sound/hda/codecs/ca0132.c
+++ b/sound/hda/codecs/ca0132.c
@@ -7071,9 +7071,18 @@ static int ca0132_alt_add_svm_enum(struct hda_codec *codec)
  */
 static int ca0132_alt_add_output_enum(struct hda_codec *codec)
 {
+	struct ca0132_spec *spec = codec->spec;
 	struct snd_kcontrol_new knew =
 		HDA_CODEC_MUTE_MONO("Output Select",
 				    OUTPUT_SOURCE_ENUM, 1, 0, HDA_OUTPUT);
+	/* AE-9: the desktop's ALSA card profiles (ACP) map an element called
+	 * "Output Select" with options Speakers/Headphone onto sink ports and
+	 * rewrite it on every route restore, which flips the ACM relay behind
+	 * the user's back (2026-09-08). A name ACP has no mapping for keeps the
+	 * routing with the driver and ae9-defaults.
+	 */
+	if (ca0132_quirk(spec) == QUIRK_AE9)
+		knew.name = "AE-9 Output";
 	knew.info = ca0132_alt_output_select_get_info;
 	knew.get = ca0132_alt_output_select_get;
 	knew.put = ca0132_alt_output_select_put;
-- 
