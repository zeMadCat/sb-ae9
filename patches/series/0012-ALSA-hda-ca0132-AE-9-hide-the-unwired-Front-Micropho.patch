From a90d80cbdab61ebfcf4abea286eba0bc73302f9e Mon Sep 17 00:00:00 2001
From: DarkNikGr <mitakidisnikos@gmail.com>
Date: Thu, 5 Nov 2026 02:17:07 +0200
Subject: [PATCH 12/24] ALSA: hda/ca0132: AE-9: hide the unwired Front
 Microphone input

The generic CA0132 Input Source selector exposes Microphone, Line In and
Front Microphone. The AE-9 has no front-panel mic, so the third item is a
silent leftover. Limit it to two items for QUIRK_AE9, as already done for
the AE-7, and clamp the cached selection in get/info.

Signed-off-by: DarkNikGr <mitakidisnikos@gmail.com>
---
 sound/hda/codecs/ca0132.c | 35 ++++++++++++++++++++++++-----------
 1 file changed, 24 insertions(+), 11 deletions(-)

diff --git a/sound/hda/codecs/ca0132.c b/sound/hda/codecs/ca0132.c
index df9eb85..4d0335b 100644
--- a/sound/hda/codecs/ca0132.c
+++ b/sound/hda/codecs/ca0132.c
@@ -6254,14 +6254,31 @@ static int ae5_sound_filter_put(struct snd_kcontrol *kcontrol,
  * front microphone has no auto-detect, and we need a way to set the rear
  * as line-in
  */
+static unsigned int ca0132_input_items(struct ca0132_spec *spec)
+{
+	/*
+	 * The AE-7 and AE-9 have no front microphone. The generic CA0132
+	 * selector exposes three items; limit those cards to rear mic and
+	 * line-in so desktop UIs do not offer a silent "Front Microphone".
+	 */
+	if (ca0132_quirk(spec) == QUIRK_AE7 ||
+	    ca0132_quirk(spec) == QUIRK_AE9)
+		return 2;
+	return IN_SRC_NUM_OF_INPUTS;
+}
+
 static int ca0132_alt_input_source_info(struct snd_kcontrol *kcontrol,
 				 struct snd_ctl_elem_info *uinfo)
 {
+	struct hda_codec *codec = snd_kcontrol_chip(kcontrol);
+	struct ca0132_spec *spec = codec->spec;
+	unsigned int items = ca0132_input_items(spec);
+
 	uinfo->type = SNDRV_CTL_ELEM_TYPE_ENUMERATED;
 	uinfo->count = 1;
-	uinfo->value.enumerated.items = IN_SRC_NUM_OF_INPUTS;
-	if (uinfo->value.enumerated.item >= IN_SRC_NUM_OF_INPUTS)
-		uinfo->value.enumerated.item = IN_SRC_NUM_OF_INPUTS - 1;
+	uinfo->value.enumerated.items = items;
+	if (uinfo->value.enumerated.item >= items)
+		uinfo->value.enumerated.item = items - 1;
 	strscpy(uinfo->value.enumerated.name,
 			in_src_str[uinfo->value.enumerated.item]);
 	return 0;
@@ -6272,8 +6289,11 @@ static int ca0132_alt_input_source_get(struct snd_kcontrol *kcontrol,
 {
 	struct hda_codec *codec = snd_kcontrol_chip(kcontrol);
 	struct ca0132_spec *spec = codec->spec;
+	unsigned int items = ca0132_input_items(spec);
 
 	ucontrol->value.enumerated.item[0] = spec->in_enum_val;
+	if (ucontrol->value.enumerated.item[0] >= items)
+		ucontrol->value.enumerated.item[0] = items - 1;
 	return 0;
 }
 
@@ -6283,14 +6303,7 @@ static int ca0132_alt_input_source_put(struct snd_kcontrol *kcontrol,
 	struct hda_codec *codec = snd_kcontrol_chip(kcontrol);
 	struct ca0132_spec *spec = codec->spec;
 	int sel = ucontrol->value.enumerated.item[0];
-	unsigned int items = IN_SRC_NUM_OF_INPUTS;
-
-	/*
-	 * The AE-7 has no front microphone, so limit items to 2: rear mic and
-	 * line-in.
-	 */
-	if (ca0132_quirk(spec) == QUIRK_AE7)
-		items = 2;
+	unsigned int items = ca0132_input_items(spec);
 
 	if (sel >= items)
 		return 0;
