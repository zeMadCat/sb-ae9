    # ── handlers ──────────────────────────────────────────────────────────────

    def write(self, name, value):
        try:
            apply_ctl(name, value)
        except RuntimeError as exc:
            self.toast(f"{name}: {exc}")
            return False
        return True

    def on_page_selected(self, _listbox, row):
        if row is None:
            return
        title = row.get_title()
        self.stack.set_visible_child_name(title)
        self.content_title.set_title(title)
        self.content_page.set_title(title)

    def on_switch(self, row, _param, name):
        if self.loading:
            return
        self.write(name, "on" if row.get_active() else "off")
        if name == "Enable OutFX":
            self.fx_group.set_sensitive(row.get_active())
        if name == "Enable InFX Capture Switch":
            for r in getattr(self, "infx_rows", []):
                r.set_sensitive(row.get_active())

    def on_combo(self, row, _param, name):
        if self.loading:
            return
        item = row.get_selected_item()
        if item is None:
            return
        if self.write(name, item.get_string()) and name == "AE-9 Output":
            self.apply_layout_lock(item.get_string())

    def on_format(self, row, _param):
        if self.loading:
            return
        idx = row.get_selected()
        if idx < 0 or idx >= len(FORMATS):
            return
        fmt = FORMATS[idx][1]
        try:
            write_format_conf(fmt)
        except OSError as exc:
            self.toast(f"format: {exc}")
            return
        self.toast(f"{fmt} saved — press Restart PipeWire to apply")

    def do_restart(self):
        if getattr(self, "_restarting", False):
            return
        self._restarting = True
        for btn in self.restart_buttons:
            btn.set_sensitive(False)
        threading.Thread(target=_restart_worker,
                         args=(mixer_state(), self._restart_done),
                         daemon=True).start()

    def _restart_done(self, msg):
        self._restarting = False
        for btn in self.restart_buttons:
            btn.set_sensitive(True)
        self.toast(msg)
        self.reload()
        return False

    def on_input_rate(self, row, _param, key, rates):
        if self.loading:
            return
        idx = row.get_selected()
        st = self.input_state.setdefault(key, {"rate": 0, "fmt": ""})
        st["rate"] = rates[idx - 1] if 0 < idx <= len(rates) else 0
        self.save_input(key)

    def on_input_fmt(self, row, _param, key):
        if self.loading:
            return
        idx = row.get_selected()
        if idx < 0 or idx >= len(INPUT_FORMATS):
            return
        st = self.input_state.setdefault(key, {"rate": 0, "fmt": ""})
        st["fmt"] = INPUT_FORMATS[idx][1]
        self.save_input(key)

    def save_input(self, key):
        st = self.input_state.get(key, {"rate": 0, "fmt": ""})
        node, _max_rate, where = INPUTS[key]
        try:
            if where == "rule":
                write_input_rule(node, st["rate"], st["fmt"])
            else:
                write_adapter_input(node, st["rate"], st["fmt"])
        except OSError as exc:
            self.toast(f"input format: {exc}")
            return
        self.toast("Format saved — press Restart PipeWire")

    def load_inputs(self):
        for key in INPUTS:
            try:
                rate, fmt = saved_input_state(key)
            except OSError:
                rate, fmt = 0, ""
            self.input_state[key] = {"rate": rate, "fmt": fmt}
            info = self.input_rows.get(key)
            if info is None:
                continue
            rates = info["rates"]
            idx = rates.index(rate) + 1 if rate in rates else 0
            info["rate"].set_selected(idx)
            values = [v for _label, v in INPUT_FORMATS]
            info["fmt"].set_selected(values.index(fmt) if fmt in values else 0)

    def on_force_rate(self, row, _param):
        if self.loading:
            return
        idx = row.get_selected()
        if idx < 0 or idx >= len(self.force_rates):
            return
        try:
            apply_force_rate(self.force_rates[idx])
        except (RuntimeError, OSError) as exc:
            self.toast(f"graph rate: {exc}")
            return
        rate = self.force_rates[idx]
        self.toast("Graph rate: auto" if rate == 0 else f"Graph rate: {rate} Hz")
        self.refresh_format()

    def on_rate(self, row, _param, rate):
        if self.loading:
            return
        rates = [r for r in sorted(self.rate_rows) if self.rate_rows[r].get_active()]
        if not rates:
            self.toast("Keep at least one sample rate on")
            self.loading = True
            row.set_active(True)
            self.loading = False
            return
        try:
            apply_allowed_rates(rates)
        except (RuntimeError, OSError) as exc:
            self.toast(f"sample rate: {exc}")
            return
        self.refresh_format()

    def on_scale(self, scale, name):
        if self.loading:
            return
        # debounce: dragging a slider emits dozens of events and we do not want
        # dozens of writes going into the DSP
        if name in self.pending:
            GLib.source_remove(self.pending[name])

        def flush():
            self.pending.pop(name, None)
            self.write(name, int(scale.get_value()))
            return GLib.SOURCE_REMOVE

        self.pending[name] = GLib.timeout_add(180, flush)

    def toast(self, text):
        self.add_toast(Adw.Toast(title=text, timeout=4))

    # ── state ─────────────────────────────────────────────────────────────────

    def on_direct_mode(self, row, _param):
        if self.loading or not row.get_active():
            return
        try:
            if read("Enable OutFX")["switch"]:
                self.write("Enable OutFX", "off")
                self.toast("Direct Mode: SBX effects switched off")
        except (RuntimeError, OSError):
            pass

    def refresh_format(self):
        r = hardware_rate()
        self.hw_rate_row.set_subtitle(f"{r} Hz" if r else "idle")
        node = find_sink()
        if node is None:
            self.format_row.set_subtitle("AE-9 sink not found")
            self.clock_row.set_subtitle("—")
            return
        try:
            fmt, ch, rate = sink_format(node)
            rates = allowed_rates()
            clock = graph_rate()
        except (RuntimeError, OSError):
            return
        self.format_row.set_subtitle(
            f"{fmt} · {ch} ch · {rate} Hz" if fmt and sink_playback_streams(node)
            else f"held at {rate} Hz (no active stream)" if fmt
            else "idle (device suspended)")
        allowed = " ".join(str(r) for r in rates) or "—"
        self.clock_row.set_subtitle(f"{clock or '—'} Hz · allowed: {allowed}")

    def _on_tick(self):
        self.refresh_format()
        self.sync_combos()
        return True

    def apply_layout_lock(self, out=None):
        """Channel layout is 2.0 and read-only on headphones.

        In Speakers mode it shows the layout stored in the card.  The
        speaker layout itself is left untouched, so switching back shows
        it again.
        """
        slot = self.widgets.get("Surround Channel Config")
        combo = slot.get("combo") if slot else None
        if combo is None:
            return
        if out is None:
            try:
                out = read("AE-9 Output")["item"]
            except RuntimeError:
                return
        head = out == "Headphone"
        combo.set_sensitive(not head)
        if head:
            target = "2.0"
        else:
            try:
                target = read("Surround Channel Config")["item"]
            except RuntimeError:
                return
        model = combo.get_model()
        items = [model.get_string(i) for i in range(model.get_n_items())]
        if target not in items:
            return
        idx = items.index(target)
        if combo.get_selected() != idx:
            was = self.loading
            self.loading = True
            combo.set_selected(idx)
            self.loading = was

    def sync_combos(self):
        """Follow the ACM/knob and the sync service.

        The driver updates the ALSA control when the knob changes the
        output; without this poll the combo would keep showing the value
        from the last manual reload.
        """
        slot = self.widgets.get("AE-9 Output")
        combo = slot.get("combo") if slot else None
        out = None
        if combo is not None:
            try:
                st = read("AE-9 Output")
            except RuntimeError:
                st = None
            if st and st["item"] in st["items"]:
                out = st["item"]
                idx = st["items"].index(out)
                if combo.get_selected() != idx:
                    self.loading = True
                    combo.set_selected(idx)
                    self.loading = False
        self.apply_layout_lock(out)

    def _on_close(self, *_args):
        if getattr(self, "_tick", None) is not None:
            GLib.source_remove(self._tick)
            self._tick = None
        return False

    def reload(self):
        self.loading = True
        try:
            for name, slots in self.widgets.items():
                try:
                    st = read(name)
                except RuntimeError:
                    continue
                if "switch" in slots and st["switch"] is not None:
                    slots["switch"].set_active(st["switch"])
                if "scale" in slots and st["value"] is not None:
                    slots["scale"].set_value(st["value"])
                if "combo" in slots and st["item"] in st["items"]:
                    slots["combo"].set_selected(st["items"].index(st["item"]))

            outfx = self.widgets.get("Enable OutFX", {}).get("switch")
            if outfx is not None:
                self.fx_group.set_sensitive(outfx.get_active())

            infx = self.widgets.get("Enable InFX Capture Switch", {}).get("switch")
            if infx is not None:
                for row in getattr(self, "infx_rows", []):
                    row.set_sensitive(infx.get_active())

            allowed = set(allowed_rates())
            for r, row in self.rate_rows.items():
                row.set_active(r in allowed)

            fr = forced_rate()
            self.force_combo.set_selected(
                self.force_rates.index(fr) if fr in self.force_rates else 0)

            self.apply_layout_lock()

            fmt = saved_format()
            values = [v for _label, v in FORMATS]
            if fmt in values:
                self.format_combo.set_selected(values.index(fmt))
            self.load_inputs()
            self.refresh_format()
        finally:
            self.loading = False

    def reset(self):
        for name, want in DEFAULTS.items():
            if isinstance(want, tuple):
                sw, lvl = want
                self.write(name, sw)
                if lvl is not None:
                    self.write(name, lvl)
            else:
                self.write(name, want)
        self.reload()
        self.toast("Reset to the manufacturer's defaults")


class App(Adw.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID)

    def do_activate(self):
        Win(self).present()


def selftest():
    """Check the parsers without opening a window."""
    print(f"card: {CARD}")
    names = [p[0] for p in PROCESSORS] + [
        "Master", "Headphone+LO", "AE-9 Output", "HP/Speaker Auto Detect",
        "Enable OutFX",
        "Surround Channel Config", "Full-Range Front Speakers",
        "Full-Range Rear Speakers", "Bass Redirection",
        "Bass Redirection Crossover", "AE-5: Sound Filter",
        "FX: Smart Volume Setting",
        "FX: X-Bass Crossover", "FX: Equalizer Preset", "EQ Band0",
        "Input Source", "Enable InFX Capture Switch",
        "FX: Voice Focus Capture Switch", "FX: Noise Reduction Capture Switch",
        "FX: Mic SVM Capture Switch", "SVM Level Capture Volume",
        "VoiceFX Capture Switch", "Capture", "Mic Boost", "What U Hear",
        "IEC958 Playback Switch", "IEC958 Capture Switch",
    ]
    if has_ctl("AE-5: Headphone Gain"):
        names.append("AE-5: Headphone Gain")
    for n in names:
        try:
            st = read(n)
        except RuntimeError as exc:
            print(f"  {n:32} ERROR {exc}")
            continue
        bits = []
        if st["switch"] is not None:
            bits.append("switch=" + ("on" if st["switch"] else "off"))
        if st["value"] is not None:
            bits.append(f"value={st['value']}")
        if st["item"] is not None:
            bits.append(f"item={st['item']!r} of {len(st['items'])}")
        print(f"  {n:32} {' '.join(bits)}")
    print(f"acm selector: {acm_selector()}")


if __name__ == "__main__":
    if "--selftest" in sys.argv:
        selftest()
    else:
        App().run(sys.argv)
