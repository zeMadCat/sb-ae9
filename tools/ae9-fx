           ("16-bit (S16LE)", "S16LE")]
INPUT_FORMATS = [("Auto (ALSA default)", ""),
                 ("32-bit (S32LE, incl. 24-bit)", "S32LE"),
                 ("16-bit (S16LE)", "S16LE")]
INPUT_RATE_CHOICES = [44100, 48000, 88200, 96000, 192000]
# key: (PipeWire node name, maximum rate, where the value is stored)
INPUTS = {
    "mic": ("alsa_input.pci-0000_29_00.0.analog-stereo", 96000, "rule"),
    "linein": ("alsa_input.ae9_linein", 192000, "adapter"),
    "wuh": ("alsa_input.ae9_wuh", 96000, "adapter"),
    "spdif": ("alsa_input.ae9_spdif", 192000, "adapter"),
    # This one is an output, but it lives in the same adapter file and uses
